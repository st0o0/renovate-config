{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset for pnpm projects -- groups version-aligned deps, automerges minor+patch (Renovate's npm manager also covers pnpm)",
  "extends": [
    "local>st0o0/renovate-config"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "description": "Group Vue + Nuxt framework packages",
      "groupName": "vue",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^vue/", "/^@vue\\//", "/^@nuxt\\//", "/^nuxt/", "/^@vitejs\\/plugin-vue/"]
    },
    {
      "description": "Group Tailwind CSS packages (tightly coupled since v4)",
      "groupName": "tailwind",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^tailwindcss$/", "/^@tailwindcss\\//"]
    },
    {
      "description": "Automerge minor+patch npm updates after CI passes",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
