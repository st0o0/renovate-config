{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset for .NET projects -- groups NuGet deps by family, automerges minor+patch",
  "extends": [
    "local>st0o0/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Disable own packages (Servus.*)",
      "matchPackageNames": ["/^Servus\\./"],
      "enabled": false
    },
    {
      "description": "Group Akka.* packages (must stay version-aligned)",
      "groupName": "akka",
      "matchPackageNames": ["/^Akka\\./"]
    },
    {
      "description": "Group Microsoft.* + Npgsql.* (EFCore provider tracks EFCore), excluding testing packages",
      "groupName": "microsoft",
      "matchPackageNames": ["/^Microsoft\\./", "/^Npgsql\\./"],
      "excludePackageNames": ["/^Microsoft\\.Testing\\./"]
    },
    {
      "description": ".NET SDK (global.json): only major updates, no automerge",
      "matchManagers": ["dotnet-sdk"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": ".NET SDK (global.json): disable minor+patch updates",
      "matchManagers": ["dotnet-sdk"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "description": "Group Serilog.* packages",
      "groupName": "serilog",
      "matchPackageNames": ["/^Serilog\\./"]
    },
    {
      "description": "Group testing packages",
      "groupName": "testing",
      "matchPackageNames": [
        "/^xunit\\./",
        "/^Microsoft\\.Testing\\./",
        "/^Verify\\./",
        "/^TngTech\\.ArchUnitNET/",
        "/^System\\.IO\\.Abstractions\\.TestingHelpers/",
        "NSubstitute",
        "FakeItEasy",
        "WireMock.Net"
      ]
    },
    {
      "description": "Group gRPC + Protobuf packages",
      "groupName": "grpc",
      "matchPackageNames": ["/^Grpc\\./", "Google.Protobuf"]
    },
    {
      "description": "Automerge minor+patch NuGet updates after CI passes",
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
