{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset for .NET projects -- groups version-aligned deps, automerges minor+patch",
  "extends": [
    "local>st0o0/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Terp and Terp.* packages changelog source",
      "matchPackageNames": ["/^Terp(\\.|$)/"],
      "sourceUrl": "https://github.com/NoNeedConcept/terp"
    },
    {
      "description": "Disable ASP.NET Core framework-coupled packages (version must track target framework)",
      "matchPackageNames": ["/^Microsoft\\.AspNetCore\\./"],
      "enabled": false
    },
    {
      "description": "Group Akka.* packages (must stay version-aligned)",
      "groupName": "akka",
      "matchPackageNames": ["/^Akka(\\.|$)/"],
      "sourceUrl": "https://github.com/akkadotnet/akka.net"
    },
    {
      "description": "Group EF Core + Npgsql provider (must stay compatible)",
      "groupName": "efcore",
      "matchPackageNames": ["/^Microsoft\\.EntityFrameworkCore/", "/^Npgsql\\.EntityFrameworkCore/"]
    },
    {
      "description": ".NET SDK (global.json): only major updates, no automerge",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": ".NET SDK (global.json): disable minor+patch updates",
      "matchManagers": ["nuget"],
      "matchDepTypes": ["dotnet-sdk"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": false
    },
    {
      "description": "Group OpenTelemetry packages (core + contrib must stay version-aligned)",
      "groupName": "opentelemetry",
      "matchPackageNames": ["/^OpenTelemetry\\./"]
    },
    {
      "description": "Group gRPC + Protobuf packages",
      "groupName": "grpc",
      "matchPackageNames": ["/^Grpc\\./", "Google.Protobuf"]
    },
    {
      "description": "Group .NET Docker images (sdk/aspnet/runtime-deps must stay version-aligned)",
      "groupName": "dotnet-docker",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^mcr\\.microsoft\\.com\\/dotnet\\//"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Digest-only rebuilds of .NET Docker images carry no functional change -- automerge immediately",
      "groupName": "dotnet-docker",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^mcr\\.microsoft\\.com\\/dotnet\\//"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge minor+patch NuGet updates after CI passes",
      "matchManagers": ["nuget"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
