{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset for Go projects -- groups version-aligned deps, automerges minor+patch",
  "extends": [
    "local>st0o0/renovate-config"
  ],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Group golang Docker base image + Go toolchain directive",
      "groupName": "go-toolchain",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Digest-only rebuilds of the golang Dockerfile base image carry no functional change -- automerge immediately",
      "groupName": "go-toolchain",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group Go toolchain directive (go X.Y in go.mod) with Docker image",
      "groupName": "go-toolchain",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep the go directive on the latest patch -- Renovate leaves it untouched by default",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group OpenTelemetry packages (core + contrib must stay version-aligned)",
      "groupName": "opentelemetry",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["/^go\\.opentelemetry\\.io\\//"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Automerge minor+patch Go module updates after CI passes",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
